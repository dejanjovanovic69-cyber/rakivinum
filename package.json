{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "cf:pages:build": "npm run build",
    "cf:pages:deploy": "wrangler pages deploy dist --project-name rakivinum",
    "cf:whoami": "wrangler whoami",
    "cf:worker:dev": "wrangler dev",
    "cf:worker:deploy": "wrangler deploy",
    "cf:smoke:edge": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-edge.ps1",
    "cf:monitor:edge": "powershell -ExecutionPolicy Bypass -File ./scripts/monitor-edge.ps1",
    "cf:deploy:resilient": "powershell -ExecutionPolicy Bypass -File ./scripts/cf-deploy-resilient.ps1",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "backup:local": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-project.ps1 -Mode daily",
    "backup:local:keep30": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-project.ps1 -KeepLast 30 -Mode daily",
    "backup:full": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-project.ps1 -Mode full -KeepLast 8"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "^4.85.0"
  }
}
