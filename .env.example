# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: comma-separated emails that should have superuser permissions.
# Example: "owner@domain.com,admin@domain.com"
VITE_SUPERUSER_EMAILS="ldjs1969@gmail.com"

# Online presence: production build defaults to DISABLED (vite.config). To turn presence back ON after an event:
# VITE_DISABLE_ONLINE_PRESENCE=0

# Incident mode: disable scan logging writes to Firestore from client scanner flow.
# Set to 1 to hard-stop `scans` writes during quota incidents.
# VITE_DISABLE_SCAN_LOG_WRITE=1

# Incident mode: freeze Home read effects (memberships/actions/recommendations).
# VITE_EMERGENCY_READ_FREEZE=1

# Incident mode: disable Home focus/visibility refresh listeners (reduce herd spikes).
# VITE_DISABLE_HOME_FOCUS_REFRESH=1

# Dijagnostika: privremeno isključi rute (zarez / razmak / tačka-zarez). Prefiks: /label isključuje sve /label/...
# Primer: VITE_DISABLED_ROUTES=/community,/scan,/menu,/distilleries,/collection,/radionica,/my-clubs,/label,/distillery

# Incident mode: disable client-side rating transaction fallback when callable is unavailable.
# VITE_DISABLE_CLIENT_RATING_FALLBACK=1

# ---------------------------------------------------------------------------
# App Check (reCAPTCHA v3) — sprečava da neko gađa Firestore direktno, mimo aplikacije.
# Site key je JAVAN i sme da stoji u bandlu; secret key ide SAMO u Firebase konzolu.
# Dok ovo nije postavljeno, App Check je isključen i aplikacija radi kao i do sada.
# Uputstvo korak po korak: docs/APP-CHECK-UPUTSTVO.md
# VITE_APPCHECK_RECAPTCHA_SITE_KEY="6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Samo za lokalni dev / CI: debug token registrovan u Firebase → App Check → Manage debug tokens.
# Ako se izostavi, u DEV-u se token generiše i ispisuje u konzoli pregledača pri svakom pokretanju.
# VITE_APPCHECK_DEBUG_TOKEN=""
